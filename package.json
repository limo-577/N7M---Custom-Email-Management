{
  "name": "n7m-custom-email-management",
  "version": "1.8.2",
  "description": "N7M - Custom Email Management",
  "main": "electron/main.cjs",
  "author": "N7M",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "start": "electron .",
    "dist": "npm run build && node build/build-windows.cjs nsis",
    "dist:portable": "npm run build && node build/build-windows.cjs portable zip",
    "test": "node --test tests/model.test.mjs tests/account-view.test.mjs tests/batch-entry.test.mjs tests/bulk-edit.test.mjs tests/edit-mutations.test.mjs tests/edit-sessions.test.cjs tests/browser-windows.test.cjs tests/browser-controller.test.cjs tests/browser-launch-firefox.test.cjs tests/vault.test.cjs tests/vault-backup.test.cjs tests/xlsx.test.cjs tests/dependencies.test.cjs build/launcher.test.cjs build/ci.test.cjs tests/dependency-policy.test.cjs tests/picomatch-isolation.test.cjs tests/risk-acceptance.test.cjs",
    "test:ui": "playwright test",
    "dist:all": "npm run build && node build/build-windows.cjs nsis portable zip",
    "check:dependencies": "node build/check-dependencies.cjs",
    "check:dependencies:online": "node build/check-dependencies.cjs --online",
    "check:picomatch": "node build/check-picomatch.cjs",
    "build:controlled": "node build/controlled-build.cjs"
  },
  "dependencies": {
    "exceljs-hardened": "5.1.1",
    "hash-wasm": "4.13.0",
    "jszip": "3.10.2",
    "minimatch": "file:vendor/n7m-minimatch-compat-1.0.2.tgz"
  },
  "devDependencies": {
    "@emnapi/core": "^2.0.0-beta.2",
    "@emnapi/runtime": "^2.0.0-beta.2",
    "@playwright/test": "1.64.1",
    "@vitejs/plugin-react": "6.1.0",
    "autoprefixer": "10.5.4",
    "concurrently": "10.0.6",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "lucide-react": "1.34.0",
    "postcss": "8.5.32",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "3.4.17",
    "vite": "8.3.7",
    "wait-on": "9.1.0",
    "yaml": "2.9.1"
  },
  "build": {
    "appId": "com.emailmanager.desktop",
    "productName": "N7M - Custom Email Management",
    "icon": "assets/2.ico",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src/model.mjs",
      "src/mutations.mjs",
      "package.json",
      "!node_modules/exceljs-hardened/dist/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-NoInstall.${ext}"
    },
    "nsis": {
      "artifactName": "${productName}-${version}-Setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "N7M - Custom Email Management"
    },
    "portable": {
      "artifactName": "${productName}-${version}-Portable.${ext}",
      "requestExecutionLevel": "user",
      "useZip": true
    }
  },
  "type": "module",
  "overrides": {
    "minimatch": "$minimatch",
    "readdir-glob@3.0.0": {
      "minimatch": "11.0.9"
    }
  }
}
