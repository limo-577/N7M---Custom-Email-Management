+// A branch led by a plain `*` absorbs any prefix within the path segment, so
+// repeating it adds nothing: `*a*a` is already a `*a`. The branch must not be
+// able to match `/` (no `/`, `**` or brackets such as `[[:punct:]]`), or the
+// leading star could not absorb an earlier repetition.
+const isStarLedBranch = branch => {
+  return branch[0] === '*' && branch[1] !== '(' && !/\/|\*\*|\[/.test(branch);
+};
